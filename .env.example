# ------------------------------------------------------------------------------------------
# FG Actuarial Science Discord bot – configuration
#
# Copy this file to `.env` (same folder) and fill in the values:   cp .env.example .env
# `.env` is git-ignored: never commit it, it contains your bot token.
# Every variable is explained in docs/configuration.md.
# ------------------------------------------------------------------------------------------

# ---- Core --------------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your server's ID. With it, slash commands appear instantly in that server.
# Leave empty to register them globally (needed if the bot is in several servers).
GUILD_ID=

# DEBUG, INFO, WARNING or ERROR. Logs go to the console and to LOG_DIR/fgbot.log.
LOG_LEVEL=INFO
LOG_DIR=logs

# ---- Features (true/false) ---------------------------------------------------------------
MUSIC_ENABLED=true
CHESS_ENABLED=true
JOBS_ENABLED=true

# ---- Music -------------------------------------------------------------------------------
# Optional: needed only for Spotify links. Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Leave the voice channel after this many seconds without music.
MUSIC_IDLE_TIMEOUT=300
# Volume for new sessions, 0-100.
MUSIC_DEFAULT_VOLUME=50

# ---- Chess -------------------------------------------------------------------------------
# Stockfish binary (a name on $PATH or a full path). Without it, /chess eval and /chess hint
# use ShessGPT only.
STOCKFISH_PATH=stockfish
# Seconds Stockfish may think per /chess eval or /chess hint.
STOCKFISH_THINK_TIME=0.5
# Optional: other ShessGPT weights. Default: the file bundled in src/fgbot/shessgpt/weights/.
# SHESSGPT_WEIGHTS=

# ---- Daily job report --------------------------------------------------------------------
# Text channel for the daily report (right-click the channel -> Copy Channel ID).
JOBS_CHANNEL_ID=
# settings.toml of the swiss-actuarial-job-scraper project (relative to this folder).
ACTJOBS_CONFIG=../swiss-actuarial-job-scraper/config/settings.toml
# When to scrape and post, in JOBS_TIMEZONE.
JOBS_TIME=07:00
JOBS_TIMEZONE=Europe/Zurich
# Only post jobs first seen within this many days (keeps a new channel from being flooded).
JOBS_MAX_AGE_DAYS=7
# Post a short "no new postings today" message when there is nothing new.
JOBS_POST_WHEN_EMPTY=true
# Attach the scraper's full Markdown report to the daily post.
JOBS_ATTACH_REPORT=true
